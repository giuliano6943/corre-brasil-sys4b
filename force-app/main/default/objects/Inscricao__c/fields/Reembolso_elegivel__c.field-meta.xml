<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Reembolso_elegivel__c</fullName>
    <formula>AND(
  ISPICKVAL(Situacao__c, &quot;Cancelada&quot;),
  OR(
    ISPICKVAL(Motivo_do_Cancelamento__c, &quot;Óbito&quot;),
    ISPICKVAL(Motivo_do_Cancelamento__c, &quot;Saúde&quot;)
  )
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Reembolso elegível</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
