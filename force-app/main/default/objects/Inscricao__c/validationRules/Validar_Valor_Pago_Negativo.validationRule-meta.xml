<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validar_Valor_Pago_Negativo</fullName>
    <active>true</active>
    <errorConditionFormula>Valor_pago__c &lt; 0</errorConditionFormula>
    <errorDisplayField>Valor_pago__c</errorDisplayField>
    <errorMessage>O valor pago não pode ser negativo. Valores a partir de R$ 0,00 são aceitos (Cortesia)</errorMessage>
</ValidationRule>
